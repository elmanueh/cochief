  "components": {
    "schemas": {
      "AuthenticationResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT used to authorize API requests."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "description": "UTC instant when the access token expires.",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Token used to renew the authentication session."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "description": "UTC instant when the refresh token expires.",
            "format": "date-time"
          }
        },
        "description": "Tokens issued for an authenticated session."
      },
      "ClanMemberResponseDto": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "description": "Player role within the clan.",
            "example": "Leader"
          }
        },
        "description": "A player's membership within the clan."
      },
      "ClanResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "description": "Clan tag including the leading hash character.",
            "example": "#9XYZ456"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClanMemberResponseDto"
            }
          }
        },
        "description": "A Clash of Clans clan and its current members."
      },
      "CreateLinkPlayerRequestDto": {
        "required": [
          "playerTag",
          "verificationToken"
        ],
        "type": "object",
        "properties": {
          "playerTag": {
            "type": "string",
            "description": "Player tag including the leading hash character.",
            "example": "#2ABC123"
          },
          "verificationToken": {
            "type": "string",
            "description": "Verification token obtained from the Clash of Clans game settings."
          }
        },
        "description": "Data required to verify and link a Clash of Clans player."
      },
      "CreateLoginRequestDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "chief@example.com"
          },
          "password": {
            "type": "string",
            "description": "The user's password."
          }
        },
        "description": "Credentials used to authenticate a user."
      },
      "CreateUserRequestDto": {
        "required": [
          "name",
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Chief"
          },
          "email": {
            "type": "string",
