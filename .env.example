# PostgreSQL

POSTGRES_DB=cochief
POSTGRES_USER=cochief
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
ConnectionStrings__PostgreSql="Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

# Authentication

# Generate a long, random secret and never commit its real value.
Authentication__Jwt__SigningKey=replace-with-at-least-32-random-bytes

# Clash of Clans API

ClashOfClans__ApiToken=your-clash-of-clans-api-token
